---
// Rendered in <head> on every page, after the theme's own tags. Add
// your own tags here: analytics, site verification, extra <meta> or
// <link>, stylesheets. This file is yours: AstroPaper never changes it
// after release.
import { isPreview } from "@/utils/isPreview";

type Props = {
  title: string;
  description: string;
};

// Google Analytics 4 の測定 ID（HTML に埋め込まれる公開値なので秘密情報ではない）
const GA_ID = "G-M8W1CJJHDT";
const gaInit = `
window.dataLayer = window.dataLayer || [];
function gtag() { dataLayer.push(arguments); }
gtag("js", new Date());
gtag("config", "${GA_ID}");
`;
---

<!-- 本文の日本語フォント（Google Fonts） -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
/>

{/* プレビュー（PUBLIC_PREVIEW=true）では検索エンジンに載せない */}
{isPreview && <meta name="robots" content="noindex, nofollow" />}

<!-- アクセス解析（Google Analytics 4）。本番用のビルドのときだけ読み込む -->
{/* プレビュー（PUBLIC_PREVIEW=true）のビルドでも読み込まない */}
{
  import.meta.env.PROD && !isPreview && (
    <Fragment>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
      />
      <script is:inline set:html={gaInit} />
    </Fragment>
  )
}
