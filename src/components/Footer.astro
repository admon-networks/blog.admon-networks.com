---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

// 運営者情報・プライバシーポリシー・お問い合わせへのリンク（全ページ共通）
const footerLinks = [
  { href: getRelativeLocaleUrl(locale, "profile"), label: "運営者情報" },
  {
    href: getRelativeLocaleUrl(locale, "privacy-policy"),
    label: "プライバシーポリシー",
  },
  { href: getRelativeLocaleUrl(locale, "contact"), label: "お問い合わせ" },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <nav aria-label="サイト情報" class="border-border border-t pt-6 sm:pt-4">
    <ul
      class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm sm:justify-start"
    >
      {
        footerLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="hover:text-accent underline-offset-4 hover:underline"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
</footer>
