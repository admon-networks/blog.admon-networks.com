---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ogImage, ...props } = data;
const url = getPostUrl(id, filePath, Astro.currentLocale);

// アイキャッチが画像ファイルとして指定されているときだけ、サムネイルを表示する
const thumbnail = ogImage && typeof ogImage !== "string" ? ogImage : undefined;
---

<li class="my-8">
  <article class="group flex flex-col gap-3 sm:flex-row sm:gap-5">
    {
      thumbnail && (
        <a
          href={url}
          tabindex="-1"
          aria-hidden="true"
          class="border-border block shrink-0 self-start overflow-hidden rounded-lg border sm:w-52 lg:w-64"
        >
          <Image
            src={thumbnail}
            alt=""
            widths={[416, 512, 832]}
            sizes="(min-width: 1024px) 256px, (min-width: 640px) 208px, 100vw"
            loading="lazy"
            class="aspect-40/21 w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </a>
      )
    }
    <div class="min-w-0">
      <a
        href={url}
        class:list={[
          "text-accent inline-block text-lg font-medium",
          "decoration-solid underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>
      <Datetime {...props} />
      <p class="line-clamp-3">{description}</p>
    </div>
  </article>
</li>
